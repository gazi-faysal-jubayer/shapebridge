# bracket: generated by ShapeBridge (https://github.com/gazi-faysal-jubayer/shapebridge)
# Units: mm. Edit the parameters below; geometry updates from them.

import FreeCAD as App

doc = App.newDocument("bracket")
sheet = doc.addObject("Spreadsheet::Sheet", "Params")
sheet.set("A1", "width")
sheet.set("B1", "80")
sheet.setAlias("B1", "width")
sheet.set("C1", "overall length")
sheet.set("A2", "depth")
sheet.set("B2", "40")
sheet.setAlias("B2", "depth")
sheet.set("A3", "thickness")
sheet.set("B3", "8")
sheet.setAlias("B3", "thickness")
sheet.set("A4", "boss_r")
sheet.set("B4", "12")
sheet.setAlias("B4", "boss_r")
sheet.set("A5", "boss_h")
sheet.set("B5", "=thickness * 2")
sheet.setAlias("B5", "boss_h")
sheet.set("A6", "hole_r")
sheet.set("B6", "=boss_r / 2")
sheet.setAlias("B6", "hole_r")
doc.recompute()

base = doc.addObject("Part::Box", "base")
base.setExpression("Length", "Params.width")
base.setExpression("Width", "Params.depth")
base.setExpression("Height", "Params.thickness")
base.setExpression("Placement.Base.x", "0")
base.setExpression("Placement.Base.y", "0")
base.setExpression("Placement.Base.z", "0")

boss = doc.addObject("Part::Cylinder", "boss")
boss.setExpression("Radius", "Params.boss_r")
boss.setExpression("Height", "Params.boss_h")
boss.setExpression("Placement.Base.x", "Params.width / 2")
boss.setExpression("Placement.Base.y", "Params.depth / 2")
boss.setExpression("Placement.Base.z", "Params.thickness")
fuse_boss = doc.addObject("Part::Fuse", "fuse_boss")
fuse_boss.Base = base
fuse_boss.Tool = boss

hole = doc.addObject("Part::Cylinder", "hole")
hole.setExpression("Radius", "Params.hole_r")
hole.setExpression("Height", "Params.thickness + Params.boss_h")
hole.setExpression("Placement.Base.x", "Params.width / 2")
hole.setExpression("Placement.Base.y", "Params.depth / 2")
hole.setExpression("Placement.Base.z", "0")
cut_hole = doc.addObject("Part::Cut", "cut_hole")
cut_hole.Base = fuse_boss
cut_hole.Tool = hole

slot_l = doc.addObject("Part::Cylinder", "slot_l")
slot_l.setExpression("Radius", "Params.thickness / 2")
slot_l.setExpression("Height", "Params.thickness")
slot_l.setExpression("Placement.Base.x", "Params.thickness * 1.5")
slot_l.setExpression("Placement.Base.y", "Params.depth / 2")
slot_l.setExpression("Placement.Base.z", "0")
cut_slot_l = doc.addObject("Part::Cut", "cut_slot_l")
cut_slot_l.Base = cut_hole
cut_slot_l.Tool = slot_l

slot_r = doc.addObject("Part::Cylinder", "slot_r")
slot_r.setExpression("Radius", "Params.thickness / 2")
slot_r.setExpression("Height", "Params.thickness")
slot_r.setExpression("Placement.Base.x", "Params.width - Params.thickness * 1.5")
slot_r.setExpression("Placement.Base.y", "Params.depth / 2")
slot_r.setExpression("Placement.Base.z", "0")
cut_slot_r = doc.addObject("Part::Cut", "cut_slot_r")
cut_slot_r.Base = cut_slot_l
cut_slot_r.Tool = slot_r

cut_slot_r.Label = "bracket"
doc.recompute()
if App.GuiUp:
    import FreeCADGui
    FreeCADGui.SendMsgToActiveView("ViewFit")
