{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShapeBridge",
  "version": "0.1.0",
  "identifier": "io.github.gazi-faysal-jubayer.shapebridge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ShapeBridge", "width": 1280, "height": 800, "minWidth": 640, "minHeight": 480, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Open-source CAD viewer, converter and parametric designer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["step", "stp", "iges", "igs", "brep", "stl", "obj", "3mf", "gltf", "glb", "3dm", "ifc", "fcstd", "fbx", "dae", "ply", "off", "wrl"], "name": "CAD model", "role": "Viewer" }
    ]
  }
}
